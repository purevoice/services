<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="WebSurf SEO is a leading Chicago SEO Company helping businesses grow organic traffic, win local rankings, and turn search into revenue. Data-driven Chicago SEO services since 2015.">
    <meta name="keywords" content="chicago seo company, chicago seo services, local seo chicago, seo agency chicago, search engine optimization chicago, chicago digital marketing, chicago seo experts">
    <meta name="author" content="WebSurf SEO">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="Chicago SEO Company - #1 SEO Agency in Chicago, IL">
    <meta property="og:description" content="Results-driven Chicago SEO company helping local businesses dominate search rankings with data-driven strategies and measurable growth.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://chicagoseocompany.netlify.app/">
    <link rel="canonical" href="https://chicagoseocompany.netlify.app/">
    <title>Chicago SEO Company - #1 SEO Company in Chicago, IL</title>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "WebSurf SEO",
        "description": "Chicago SEO company specializing in organic search optimization, local SEO, technical SEO audits, content strategy, and link building for businesses throughout the greater Chicago metropolitan area.",
        "priceRange": "$2,500 - $15,000/mo",
        "telephone": "+1-312-555-0199",
        "email": "hello@websurfseo.com",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "233 S Wacker Dr, Suite 4500",
            "addressLocality": "Chicago",
            "addressRegion": "IL",
            "postalCode": "60606",
            "addressCountry": "US"
        },
        "geo": { "@type": "GeoCoordinates", "latitude": 41.8789, "longitude": -87.6359 },
        "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "127", "bestRating": "5" },
        "areaServed": [
            {"@type": "City", "name": "Chicago"},
            {"@type": "City", "name": "Naperville"},
            {"@type": "City", "name": "Evanston"},
            {"@type": "City", "name": "Schaumburg"},
            {"@type": "City", "name": "Oak Park"},
            {"@type": "City", "name": "Arlington Heights"},
            {"@type": "City", "name": "Aurora"},
            {"@type": "City", "name": "Joliet"}
        ],
        "serviceType": ["Search Engine Optimization", "Local SEO Chicago", "Technical SEO Audit", "On-Page Optimization", "Content Marketing", "Link Building", "Google Business Profile Optimization", "Enterprise SEO", "AI Search Optimization"]
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "What makes WebSurf SEO the best Chicago SEO company?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "WebSurf SEO combines deep Chicago market knowledge with data-driven SEO methodology. Our team has more than 10 years of experience optimizing websites for Chicago businesses across Cook County, DuPage County, and the greater Chicagoland area. Clients see an average organic traffic increase of 312% through custom strategies targeting local search intent, technical optimization, and authority building."
                }
            },
            {
                "@type": "Question",
                "name": "How long does it take to see SEO results in Chicago?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Most Chicago businesses see measurable improvements within 3 to 6 months, with significant results in 6 to 12 months. Local SEO improvements for Google Business Profile and local pack rankings often appear within 2 to 3 months, and technical SEO fixes can move rankings within weeks."
                }
            },
            {
                "@type": "Question",
                "name": "What areas does WebSurf SEO serve in the Chicago metropolitan area?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "We serve businesses throughout the greater Chicago metropolitan area including the Loop, River North, Lincoln Park, Wicker Park, Lakeview, Naperville, Evanston, Schaumburg, Oak Park, Arlington Heights, Aurora, Joliet, Elmhurst, and Wheaton, plus surrounding Cook County, DuPage County, Lake County, and Kane County communities."
                }
            },
            {
                "@type": "Question",
                "name": "How much do Chicago SEO services cost?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Chicago SEO services typically range from $2,500 to $15,000 per month depending on scope, competition, and business goals. WebSurf SEO builds custom strategies instead of cookie-cutter packages, and every engagement begins with a comprehensive audit and a clear roadmap tied to ROI."
                }
            }
        ]
    }
    </script>

    <style>
        :root {
            --blue: #0A2472;
            --blue-dark: #061642;
            --blue-darker: #040F2E;
            --blue-light: #1E3A8A;
            --blue-bright: #2563EB;
            --yellow: #FFD700;
            --yellow-hover: #FFC107;
            --yellow-light: #FFF3B0;
            --white: #FFFFFF;
            --off-white: #F6F8FC;
            --light-gray: #E4E9F2;
            --mid-gray: #8A94A6;
            --dark-gray: #46536B;
            --success-green: #10B981;
            --shadow-sm: 0 1px 3px rgba(4, 15, 46, 0.08);
            --shadow-md: 0 4px 16px rgba(4, 15, 46, 0.12);
            --shadow-lg: 0 12px 40px rgba(4, 15, 46, 0.16);
            --radius-sm: 6px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: var(--blue);
            background: var(--white);
            line-height: 1.7;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }
        img, svg { max-width: 100%; height: auto; display: block; }
        a { text-decoration: none; color: inherit; transition: var(--transition); }
        ul, ol { list-style: none; }
        button { font-family: inherit; }

        h1, h2, h3, h4 { font-weight: 800; line-height: 1.2; color: var(--blue); }
        h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
        h2 { font-size: clamp(1.9rem, 4vw, 2.9rem); }
        h3 { font-size: clamp(1.3rem, 2.5vw, 1.6rem); }
        h4 { font-size: 1.2rem; }
        p { color: var(--dark-gray); line-height: 1.8; }

        .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
        section { padding: 100px 0; }

        .section-header { text-align: center; max-width: 760px; margin: 0 auto 64px; }
        .section-label {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px;
            color: var(--blue); background: var(--yellow-light);
            padding: 8px 20px; border-radius: 50px; margin-bottom: 20px;
        }
        .section-label::before {
            content: ''; width: 8px; height: 8px; background: var(--yellow);
            border-radius: 50%; animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.3); }
        }

        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 10px;
            padding: 16px 36px; font-size: 1rem; font-weight: 700;
            border-radius: var(--radius-sm); cursor: pointer; transition: var(--transition);
            border: 2px solid transparent; text-align: center;
        }
        .btn-primary { background: var(--yellow); color: var(--blue-dark); border-color: var(--yellow); }
        .btn-primary:hover { background: var(--yellow-hover); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4); }
        .btn-secondary { background: transparent; color: var(--white); border-color: var(--white); }
        .btn-secondary:hover { background: var(--white); color: var(--blue); }

        /* ============ NAV ============ */
        .navbar {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            background: rgba(6, 22, 66, 0.97);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .navbar.scrolled { box-shadow: var(--shadow-md); }
        .nav-container {
            max-width: 1280px; margin: 0 auto; padding: 0 24px;
            display: flex; align-items: center; justify-content: space-between; height: 80px;
        }
        .nav-logo { display: flex; align-items: center; gap: 12px; font-size: 1.4rem; font-weight: 800; color: var(--white); }
        .nav-logo-icon {
            width: 42px; height: 42px; background: var(--yellow); border-radius: var(--radius-sm);
            display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
        }
        .nav-logo span { color: var(--yellow); }
        .nav-links { display: flex; align-items: center; gap: 34px; }
        .nav-links a { color: rgba(255, 255, 255, 0.85); font-weight: 500; font-size: 0.95rem; position: relative; }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px;
            background: var(--yellow); transition: var(--transition);
        }
        .nav-links a:hover { color: var(--white); }
        .nav-links a:hover::after { width: 100%; }
        .nav-cta { background: var(--yellow); color: var(--blue-dark) !important; padding: 10px 24px; border-radius: var(--radius-sm); font-weight: 700; }
        .nav-cta:hover { background: var(--yellow-hover); transform: translateY(-1px); }
        .nav-cta::after { display: none; }
        .nav-toggle { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; background: none; border: none; }
        .nav-toggle span { width: 28px; height: 3px; background: var(--white); border-radius: 2px; transition: var(--transition); }
        .nav-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 6px); }
        .nav-toggle.active span:nth-child(2) { opacity: 0; }
        .nav-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -6px); }

        /* ============ HERO ============ */
        .hero {
            position: relative; min-height: 100vh; display: flex; align-items: center;
            background: linear-gradient(135deg, var(--blue-darker) 0%, var(--blue-dark) 50%, var(--blue) 100%);
            overflow: hidden; padding-top: 80px;
        }
        .hero::before {
            content: ''; position: absolute; inset: 0;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(255, 215, 0, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(37, 99, 235, 0.12) 0%, transparent 50%);
        }
        .hero-grid-bg {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px; opacity: 0.5;
        }
        .hero-content { position: relative; z-index: 2; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 60px; align-items: center; }
        .hero-text { color: var(--white); }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 10px;
            background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.3);
            padding: 10px 20px; border-radius: 50px; font-size: 0.85rem; font-weight: 600;
            color: var(--yellow); margin-bottom: 28px;
        }
        .hero-badge-dot { width: 10px; height: 10px; background: var(--yellow); border-radius: 50%; animation: pulse 2s infinite; }
        .hero h1 { color: var(--white); margin-bottom: 24px; font-size: clamp(2.6rem, 5.5vw, 4.3rem); line-height: 1.1; }
        .hero h1 .highlight { color: var(--yellow); position: relative; }
        .hero h1 .highlight::after {
            content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 6px;
            background: rgba(255, 215, 0, 0.3); border-radius: 3px;
        }
        .hero-description { font-size: 1.15rem; color: rgba(255, 255, 255, 0.8); margin-bottom: 40px; max-width: 560px; line-height: 1.8; }
        .hero-buttons { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 50px; }
        .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .hero-stat-number { font-size: 2.5rem; font-weight: 800; color: var(--yellow); line-height: 1; margin-bottom: 4px; }
        .hero-stat-label { font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); font-weight: 500; }
        .hero-card {
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-lg); padding: 40px; backdrop-filter: blur(20px);
            position: relative; overflow: hidden;
        }
        .hero-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--yellow), var(--blue-bright)); }
        .hero-card-title { color: var(--white); font-size: 1.1rem; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }
        .hero-card-title::before { content: '📊'; font-size: 1.3rem; }
        .hero-metric { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
        .hero-metric:last-child { border-bottom: none; }
        .hero-metric-label { color: rgba(255, 255, 255, 0.7); font-size: 0.9rem; }
        .hero-metric-value { color: var(--yellow); font-weight: 700; font-size: 1rem; }
        .hero-metric-change { color: var(--success-green); font-size: 0.8rem; margin-left: 8px; }
        .hero-floating-badge {
            position: absolute; background: var(--white); padding: 12px 20px; border-radius: var(--radius-sm);
            box-shadow: var(--shadow-lg); font-size: 0.85rem; font-weight: 600; color: var(--blue);
            display: flex; align-items: center; gap: 8px; animation: float 3s ease-in-out infinite;
        }
        .hero-floating-badge.badge-1 { top: -20px; right: -10px; }
        .hero-floating-badge.badge-2 { bottom: -20px; left: -10px; animation-delay: 1.5s; }
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

        /* ============ TRUST BAR ============ */
        .trust-bar { background: var(--off-white); padding: 50px 0; border-bottom: 1px solid var(--light-gray); }
        .trust-bar-content { text-align: center; }
        .trust-bar-label { font-size: 0.85rem; font-weight: 600; color: var(--mid-gray); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 30px; }
        .trust-logos { display: flex; align-items: center; justify-content: center; gap: 50px; flex-wrap: wrap; opacity: 0.6; }
        .trust-logo { font-size: 1.25rem; font-weight: 800; color: var(--blue); letter-spacing: -0.5px; }

        /* ============ SPLIT LAYOUT (text left, visual right) ============ */
        .split-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 70px; align-items: center; }
        .split-text .section-label { margin-bottom: 16px; }
        .split-text h2 { margin-bottom: 24px; }
        .split-text > p { margin-bottom: 20px; font-size: 1.05rem; }

        .gain-card {
            background: var(--white); border: 1px solid var(--light-gray); border-radius: var(--radius-lg);
            padding: 40px; box-shadow: var(--shadow-lg); position: relative; overflow: hidden;
        }
        .gain-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--yellow); }
        .gain-card h3 { margin-bottom: 26px; display: flex; align-items: center; gap: 12px; }
        .gain-row { display: flex; align-items: center; gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--light-gray); }
        .gain-row:last-child { border-bottom: none; }
        .gain-icon {
            width: 52px; height: 52px; flex-shrink: 0; border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-light) 100%);
            display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
        }
        .gain-row p { font-size: 0.95rem; }
        .gain-row strong { color: var(--blue); }

        /* ============ CTA SECTIONS ============ */
        .cta-section {
            background: linear-gradient(135deg, var(--blue-darker) 0%, var(--blue-dark) 60%, var(--blue) 100%);
            padding: 90px 0; position: relative; overflow: hidden;
        }
        .cta-section::before {
            content: ''; position: absolute; inset: 0;
            background:
                radial-gradient(ellipse at 30% 50%, rgba(255, 215, 0, 0.1) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 50%, rgba(37, 99, 235, 0.1) 0%, transparent 50%);
        }
        .cta-content { position: relative; z-index: 2; text-align: center; max-width: 720px; margin: 0 auto; }
        .cta-content h2 { color: var(--white); margin-bottom: 20px; }
        .cta-content h2 .highlight { color: var(--yellow); }
        .cta-content p { color: rgba(255, 255, 255, 0.8); font-size: 1.1rem; margin-bottom: 36px; }
        .cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
        .cta-phone { display: flex; align-items: center; justify-content: center; gap: 10px; color: rgba(255, 255, 255, 0.7); font-size: 1rem; flex-wrap: wrap; }
        .cta-phone a { color: var(--yellow); font-weight: 700; font-size: 1.2rem; }
        .cta-phone a:hover { color: var(--yellow-hover); }

        /* ============ ABOUT ============ */
        .about-section { background: var(--white); }
        .about-features { margin-top: 32px; display: grid; gap: 16px; }
        .about-feature { display: flex; align-items: center; gap: 14px; }
        .about-feature-icon {
            width: 28px; height: 28px; background: var(--yellow-light); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .about-feature-icon::after { content: '✓'; font-weight: 800; font-size: 0.8rem; color: var(--blue); }
        .about-feature p { font-size: 0.95rem; line-height: 1.6; }
        .about-feature strong { color: var(--blue); }
        .about-visual {
            background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue) 100%);
            border-radius: var(--radius-lg); padding: 48px 40px; color: var(--white);
            position: relative; overflow: hidden; box-shadow: var(--shadow-lg);
        }
        .about-visual::before {
            content: ''; position: absolute; top: -50%; right: -50%; width: 100%; height: 100%;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.12) 0%, transparent 70%);
        }
        .about-year { position: relative; }
        .about-year .big { font-size: 3.4rem; font-weight: 900; color: var(--yellow); line-height: 1; }
        .about-year .small { font-size: 0.9rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); margin-bottom: 8px; }
        .about-stats { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; }
        .about-stat { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-md); padding: 20px; text-align: center; }
        .about-stat .num { font-size: 1.8rem; font-weight: 800; color: var(--yellow); line-height: 1.1; }
        .about-stat .lbl { font-size: 0.8rem; color: rgba(255, 255, 255, 0.7); margin-top: 4px; }

        /* ============ SERVICES (icon inline with title) ============ */
        .services-section { background: var(--off-white); }
        .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .service-card {
            background: var(--white); border-radius: var(--radius-md); padding: 36px 30px;
            transition: var(--transition); border: 1px solid var(--light-gray);
            position: relative; overflow: hidden;
        }
        .service-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: var(--yellow); transform: scaleX(0); transform-origin: left; transition: var(--transition);
        }
        .service-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: transparent; }
        .service-card:hover::before { transform: scaleX(1); }
        .service-head { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
        .service-icon {
            width: 56px; height: 56px; flex-shrink: 0;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-light) 100%);
            border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;
            font-size: 1.6rem; transition: var(--transition);
        }
        .service-card:hover .service-icon { background: linear-gradient(135deg, var(--yellow) 0%, var(--yellow-hover) 100%); transform: scale(1.05); }
        .service-head h3 { font-size: 1.2rem; }
        .service-card p { font-size: 0.95rem; margin-bottom: 18px; }
        .service-tags { display: flex; flex-wrap: wrap; gap: 8px; }
        .service-tag { font-size: 0.75rem; font-weight: 600; color: var(--blue); background: var(--yellow-light); padding: 4px 12px; border-radius: 50px; }

        /* ============ CHICAGO MARKET ============ */
        .market-section { background: var(--white); }
        .market-visual { position: relative; }
        .market-card {
            background: linear-gradient(160deg, var(--blue-dark) 0%, var(--blue) 100%);
            border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);
        }
        .market-card svg { width: 100%; height: auto; display: block; }
        .market-caption { padding: 22px 28px; color: rgba(255, 255, 255, 0.85); font-size: 0.95rem; display: flex; align-items: center; gap: 10px; }
        .market-floating {
            position: absolute; background: var(--white); padding: 12px 20px; border-radius: var(--radius-sm);
            box-shadow: var(--shadow-lg); font-size: 0.85rem; font-weight: 700; color: var(--blue);
            display: flex; align-items: center; gap: 8px; animation: float 3s ease-in-out infinite;
        }
        .market-floating.mf-1 { top: -18px; left: -10px; }
        .market-floating.mf-2 { bottom: 60px; right: -12px; animation-delay: 1.5s; }
        .market-points { margin-top: 28px; display: grid; gap: 16px; }
        .market-point { display: flex; align-items: center; gap: 14px; }
        .market-point-icon {
            width: 44px; height: 44px; flex-shrink: 0; border-radius: var(--radius-sm);
            background: var(--yellow-light); display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
        }
        .market-point p { font-size: 0.95rem; }
        .market-point strong { color: var(--blue); }

        /* ============ RESULTS ============ */
        .results-section { background: var(--off-white); }
        .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .result-card { background: var(--white); border-radius: var(--radius-md); overflow: hidden; transition: var(--transition); border: 1px solid var(--light-gray); }
        .result-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
        .result-header { background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue) 100%); padding: 30px; color: var(--white); }
        .result-company { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--yellow); margin-bottom: 8px; }
        .result-industry { font-size: 0.9rem; color: rgba(255, 255, 255, 0.7); }
        .result-stats { padding: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .result-stat { text-align: center; }
        .result-stat-value { font-size: 1.9rem; font-weight: 800; color: var(--blue); line-height: 1; margin-bottom: 6px; }
        .result-stat-value span { color: var(--success-green); }
        .result-stat-label { font-size: 0.8rem; color: var(--mid-gray); font-weight: 500; }
        .result-description { padding: 0 30px 30px; font-size: 0.9rem; }

        /* ============ INDUSTRIES TABS ============ */
        .industries-section { background: var(--white); }
        .tabs-bar { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 44px; }
        .tab-btn {
            display: flex; align-items: center; gap: 8px; padding: 12px 22px;
            border-radius: 50px; border: 2px solid var(--light-gray); background: var(--white);
            font-weight: 700; font-size: 0.92rem; color: var(--blue); cursor: pointer; transition: var(--transition);
        }
        .tab-btn:hover { border-color: var(--yellow); transform: translateY(-2px); }
        .tab-btn.active { background: var(--yellow); border-color: var(--yellow); color: var(--blue-dark); box-shadow: 0 6px 20px rgba(255, 215, 0, 0.35); }
        .tab-panel { display: none; }
        .tab-panel.active {
            display: flex; align-items: center; gap: 34px;
            background: var(--off-white); border: 1px solid var(--light-gray);
            border-radius: var(--radius-lg); padding: 44px; animation: panelIn 0.4s ease;
        }
        @keyframes panelIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
        .panel-icon {
            width: 96px; height: 96px; flex-shrink: 0; border-radius: var(--radius-lg);
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-light) 100%);
            display: flex; align-items: center; justify-content: center; font-size: 2.6rem;
            box-shadow: var(--shadow-md);
        }
        .panel-content h3 { margin-bottom: 10px; }
        .panel-content p { font-size: 1rem; margin-bottom: 16px; }
        .panel-chips { display: flex; gap: 8px; flex-wrap: wrap; }
        .panel-chip { font-size: 0.78rem; font-weight: 700; color: var(--blue); background: var(--yellow-light); padding: 5px 14px; border-radius: 50px; }

        /* ============ AREAS ============ */
        .areas-section { background: var(--blue-dark); position: relative; overflow: hidden; }
        .areas-section::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(ellipse at 50% 0%, rgba(255, 215, 0, 0.07) 0%, transparent 60%);
        }
        .areas-section .section-header { position: relative; z-index: 2; }
        .areas-section h2 { color: var(--white); }
        .areas-section .section-header p { color: rgba(255, 255, 255, 0.7); }
        .areas-section .section-label { background: rgba(255, 215, 0, 0.15); color: var(--yellow); }
        .areas-grid {
            position: relative; z-index: 2;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px;
        }
        .area-chip {
            display: flex; align-items: center; gap: 10px; padding: 15px 18px;
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-sm); font-weight: 600; font-size: 0.92rem; color: var(--white);
            transition: var(--transition);
        }
        .area-chip .pin {
            width: 10px; height: 10px; flex-shrink: 0; border-radius: 50%;
            background: var(--yellow); box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.2);
        }
        .area-chip:hover { border-color: var(--yellow); transform: translateY(-3px); background: rgba(255, 215, 0, 0.08); }
        .areas-note { position: relative; z-index: 2; text-align: center; margin-top: 36px; color: rgba(255, 255, 255, 0.7); font-size: 0.95rem; }
        .areas-note strong { color: var(--yellow); }

        /* ============ WHY ============ */
        .why-section { background: var(--white); }
        .why-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 34px; }
        .why-card {
            display: flex; align-items: center; gap: 20px; padding: 30px;
            border-radius: var(--radius-md); transition: var(--transition); border: 1px solid transparent;
        }
        .why-card:hover { background: var(--off-white); border-color: var(--light-gray); }
        .why-card-icon {
            width: 56px; height: 56px; flex-shrink: 0; background: var(--blue);
            border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; transition: var(--transition);
        }
        .why-card:hover .why-card-icon { background: var(--yellow); transform: rotate(-5deg) scale(1.05); }
        .why-card h4 { margin-bottom: 8px; font-size: 1.12rem; }
        .why-card p { font-size: 0.93rem; }

        /* ============ TESTIMONIALS ============ */
        .testimonials-section { background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue) 100%); position: relative; overflow: hidden; }
        .testimonials-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 80%, rgba(255, 215, 0, 0.08) 0%, transparent 50%); }
        .testimonials-section .section-header { position: relative; z-index: 2; }
        .testimonials-section h2 { color: var(--white); }
        .testimonials-section .section-header p { color: rgba(255, 255, 255, 0.7); }
        .testimonials-section .section-label { background: rgba(255, 215, 0, 0.15); color: var(--yellow); }
        .testimonials-slider { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; }
        .testimonial-card {
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-lg); padding: 48px; text-align: center; backdrop-filter: blur(10px);
        }
        .testimonial-quote { font-size: 1.25rem; font-style: italic; color: rgba(255, 255, 255, 0.9); margin-bottom: 32px; line-height: 1.8; position: relative; transition: opacity 0.2s ease; }
        .testimonial-quote::before {
            content: '"'; font-size: 5rem; color: var(--yellow); opacity: 0.3; position: absolute;
            top: -30px; left: 50%; transform: translateX(-50%); font-family: Georgia, serif;
        }
        .testimonial-author { display: flex; align-items: center; justify-content: center; gap: 16px; }
        .testimonial-avatar {
            width: 56px; height: 56px; background: var(--yellow); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--blue-dark); font-size: 1.2rem;
        }
        .testimonial-info h4 { color: var(--white); margin-bottom: 2px; }
        .testimonial-info p { font-size: 0.9rem; color: rgba(255, 255, 255, 0.6); }
        .testimonial-dots { display: flex; justify-content: center; gap: 12px; margin-top: 32px; }
        .testimonial-dot { width: 12px; height: 12px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); cursor: pointer; transition: var(--transition); border: none; }
        .testimonial-dot.active { background: var(--yellow); transform: scale(1.2); }

        /* ============ FAQ ============ */
        .faq-section { background: var(--off-white); }
        .faq-container { max-width: 820px; margin: 0 auto; }
        .faq-item { background: var(--white); border-radius: var(--radius-md); margin-bottom: 16px; border: 1px solid var(--light-gray); overflow: hidden; transition: var(--transition); }
        .faq-item:hover { border-color: var(--yellow); }
        .faq-item.active { box-shadow: var(--shadow-md); border-color: var(--yellow); }
        .faq-question { padding: 24px 30px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
        .faq-question h4 { font-size: 1.05rem; font-weight: 600; flex: 1; }
        .faq-toggle {
            width: 32px; height: 32px; background: var(--yellow-light); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: var(--transition);
        }
        .faq-toggle::after { content: '+'; font-size: 1.3rem; font-weight: 700; color: var(--blue); transition: var(--transition); }
        .faq-item.active .faq-toggle { background: var(--yellow); transform: rotate(45deg); }
        .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
        .faq-item.active .faq-answer { max-height: 500px; }
        .faq-answer-content { padding: 0 30px 24px; }
        .faq-answer-content p { font-size: 0.95rem; line-height: 1.8; }

        /* ============ FOOTER ============ */
        .footer { background: var(--blue-darker); color: rgba(255, 255, 255, 0.7); padding: 80px 0 30px; border-top: 1px solid rgba(255, 255, 255, 0.05); }
        .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 50px; margin-bottom: 60px; }
        .footer-brand .nav-logo { margin-bottom: 20px; }
        .footer-brand p { color: rgba(255, 255, 255, 0.6); font-size: 0.95rem; margin-bottom: 24px; line-height: 1.8; }
        .footer-awards { display: flex; gap: 16px; flex-wrap: wrap; }
        .footer-award { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); padding: 8px 16px; border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 600; color: var(--yellow); }
        .footer-column h4 { color: var(--white); margin-bottom: 20px; font-size: 1rem; }
        .footer-links li { margin-bottom: 12px; }
        .footer-links a { color: rgba(255, 255, 255, 0.6); font-size: 0.9rem; }
        .footer-links a:hover { color: var(--yellow); padding-left: 4px; }
        .footer-contact-item { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
        .footer-contact-icon { font-size: 1.2rem; flex-shrink: 0; }
        .footer-contact-item p { color: rgba(255, 255, 255, 0.6); font-size: 0.9rem; }
        .footer-contact-item a { color: rgba(255, 255, 255, 0.6); }
        .footer-contact-item a:hover { color: var(--yellow); }
        .footer-bottom { padding-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
        .footer-bottom p { color: rgba(255, 255, 255, 0.5); font-size: 0.85rem; }
        .footer-bottom-links { display: flex; gap: 24px; }
        .footer-bottom-links a { color: rgba(255, 255, 255, 0.5); font-size: 0.85rem; }
        .footer-bottom-links a:hover { color: var(--yellow); }

        .back-to-top {
            position: fixed; bottom: 30px; right: 30px; width: 50px; height: 50px;
            background: var(--yellow); color: var(--blue-dark); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800;
            cursor: pointer; opacity: 0; visibility: hidden; transition: var(--transition);
            box-shadow: var(--shadow-md); z-index: 999; border: none;
        }
        .back-to-top.visible { opacity: 1; visibility: visible; }
        .back-to-top:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 1024px) {
            .hero-content, .split-grid { grid-template-columns: 1fr; gap: 50px; }
            .hero-visual, .split-visual { max-width: 560px; width: 100%; }
            .services-grid, .results-grid { grid-template-columns: repeat(2, 1fr); }
            .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; }
        }
        @media (max-width: 768px) {
            section { padding: 70px 0; }
            .nav-links {
                display: none; position: fixed; top: 80px; left: 0; right: 0;
                background: var(--blue-darker); flex-direction: column; padding: 30px; gap: 20px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }
            .nav-links.active { display: flex; }
            .nav-toggle { display: flex; }
            .hero { min-height: auto; padding-top: 120px; padding-bottom: 80px; }
            .hero-buttons { flex-direction: column; }
            .hero-card { padding: 30px; }
            .services-grid, .results-grid, .why-grid { grid-template-columns: 1fr; }
            .tab-panel.active { flex-direction: column; align-items: flex-start; gap: 22px; padding: 32px 26px; }
            .testimonial-card { padding: 32px 24px; }
            .testimonial-quote { font-size: 1.05rem; }
            .trust-logos { gap: 28px; }
            .footer-grid { grid-template-columns: 1fr; gap: 40px; }
            .footer-bottom { flex-direction: column; text-align: center; }
            .cta-buttons { flex-direction: column; }
            .market-floating { display: none; }
        }
        @media (max-width: 480px) {
            .container { padding: 0 16px; }
            .hero-stats { grid-template-columns: 1fr; gap: 12px; }
            .hero-stat { display: flex; align-items: center; gap: 12px; }
            .hero-floating-badge { display: none; }
            .about-stats { grid-template-columns: 1fr 1fr; gap: 12px; }
            .areas-grid { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
